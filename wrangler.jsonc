{
  // Static site on Cloudflare Workers (static assets). Deploy: npm run build && npx wrangler deploy
  "name": "pramodburra",
  "compatibility_date": "2026-10-23",
  "workers_dev": true,
  "routes": [
    { "pattern": "pramodburra.com", "custom_domain": true },
    { "pattern": "www.pramodburra.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
